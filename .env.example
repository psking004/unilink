# Copy to .env.local for the frontend (Vite). Everything here ends up in the browser bundle,
# so never put private keys (like GEMINI_API_KEY) in this file - that belongs in backend/.env.

# URL of the FastAPI backend (serves POST /ai/feedback). Defaults to http://localhost:8000.
VITE_API_URL=http://localhost:8000

# Supabase project (public anon key). If these are empty the app runs on a local in-browser mock database.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
