# Environment for the FastAPI backend (backend/main.py). Never commit real values.

# Gemini API key for AI-generated assignment feedback (POST /ai/feedback).
GEMINI_API_KEY=
# Optional: override the Gemini model (default: gemini-3.8-flash).
GEMINI_MODEL=gemini-3.8-flash

# Comma-separated list of frontend origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:3000

# Supabase project. Leave empty to run the API without database endpoints.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
